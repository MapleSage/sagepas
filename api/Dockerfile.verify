FROM rust:1.88-slim-bookworm AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
RUN cargo build --release -p doc-pipeline --example verify

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates poppler-utils && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/examples/verify /usr/local/bin/verify
WORKDIR /app
CMD ["sleep", "600"]
