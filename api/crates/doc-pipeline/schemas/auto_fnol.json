  },
  "description": "A class representing an Auto / Vehicle First Notice of Loss form.\n\nAttributes:\n    policyholder_info: Policyholder contact and licence details\n    policy_info: Auto insurance policy information\n    vehicle_info: Insured vehicle details\n    accident_details: Accident or loss event details\n    damage_estimate: Vehicle damage and repair estimate\n    third_parties: List of other parties involved\n    declaration: Declaration and signature section",
  "properties": {
    "policyholder_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyholderInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Policyholder contact and licence details"
    },
    "policy_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Auto insurance policy information"
    },
    "vehicle_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/VehicleInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Insured vehicle details"
    },
    "accident_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccidentDetails"
        },
        {
          "type": "null"
        }
      ],
      "description": "Accident or loss event details"
    },
    "damage_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/DamageEstimate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Vehicle damage and repair estimate"
    },
    "third_parties": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ThirdPartyInfo"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "description": "List of other parties involved in the accident",
      "title": "Third Parties"
    },
    "declaration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Declaration"
        },
        {
          "type": "null"
        }
      ],
      "description": "Declaration and signature section"
    }
  },
  "required": [
    "policyholder_info",
    "policy_info",
    "vehicle_info",
    "accident_details",
    "damage_estimate",
    "third_parties",
    "declaration"
  ],
  "title": "AutoVehicleFNOL",
  "type": "object"
}