          "description": "Name of the other party",
          "title": "Name"
        },
        "telephone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Telephone number of the other party",
          "title": "Telephone"
        },
        "insurance_company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
