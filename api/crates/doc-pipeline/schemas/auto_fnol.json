        "insurance_policy_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other party's insurance policy number",
          "title": "Insurance Policy Number"
        },
        "vehicle_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other party's vehicle year",
          "title": "Vehicle Year"
        },
        "vehicle_make": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other party's vehicle make",
          "title": "Vehicle Make"
        },
        "vehicle_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other party's vehicle model",
          "title": "Vehicle Model"
        },
        "vehicle_license_plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other party's license plate number",
          "title": "Vehicle License Plate"
        }
      },
      "required": [
        "name",
        "telephone",
        "insurance_company",
        "insurance_policy_number",
        "vehicle_year",
        "vehicle_make",
        "vehicle_model",
        "vehicle_license_plate"
      ],
      "title": "ThirdPartyInfo",
      "type": "object"
    },
    "VehicleInfo": {
      "description": "Details about the insured vehicle.",
      "properties": {
        "year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vehicle year, e.g. 2021",
          "title": "Year"
        },
        "make": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vehicle make, e.g. Toyota",
          "title": "Make"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vehicle model, e.g. Camry",
          "title": "Model"
