          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "License plate number",
          "title": "License Plate"
        },
        "license_plate_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "State of license plate",
          "title": "License Plate State"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vehicle color",
          "title": "Color"
        },
        "odometer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
