    "policyholder": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyholderInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Information about the policyholder or insured person"
    },
    "deceased": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeceasedInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Information about the deceased (for death benefit claims)"
