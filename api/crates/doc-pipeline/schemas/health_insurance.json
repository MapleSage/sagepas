  "description": "Health insurance claim, Explanation of Benefits (EOB), or insurance card document.\nExtracts patient, plan, provider, and claim line item details.",
  "properties": {
    "patient": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatientInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Patient/member information"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/InsurancePlanInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Health insurance plan details"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Treating provider or facility information"
    },
    "claim_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Unique claim reference number assigned by the insurer",
      "title": "Claim Number"
    },
    "claim_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Date the claim was submitted, e.g. 2026-04-01",
      "title": "Claim Date"
    },
    "total_billed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Total amount billed across all line items",
      "title": "Total Billed"
    },
    "total_paid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Total amount paid by insurance",
      "title": "Total Paid"
    },
    "total_patient_responsibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Total amount owed by the patient",
      "title": "Total Patient Responsibility"
    },
    "line_items": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ClaimLineItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "description": "Individual service line items on the claim",
      "title": "Line Items"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Additional notes, denial reasons, or remarks",
      "title": "Notes"
    },
    "declaration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Signature"
        },
        {
          "type": "null"
        }
      ],
      "description": "Signature/authorization section of the document"
    }
  },
  "required": [
    "patient",
    "plan",
    "provider",
    "claim_number",
    "claim_date",
    "total_billed",
    "total_paid",
    "total_patient_responsibility",
    "line_items",
    "notes",
    "declaration"
  ],
  "title": "HealthInsurance",
  "type": "object"
}