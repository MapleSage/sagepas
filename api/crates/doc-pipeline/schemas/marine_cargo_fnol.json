    "shipment_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShipmentDetails"
        },
        {
          "type": "null"
        }
      ],
      "description": "Details about the cargo shipment"
    },
    "loss_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/LossDetails"
        },
        {
          "type": "null"
        }
      ],
      "description": "Details about the loss or damage"
    },
    "declaration": {
      "anyOf": [
        {
