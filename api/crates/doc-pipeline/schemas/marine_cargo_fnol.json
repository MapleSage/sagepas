    "LossDetails": {
      "description": "Details about the loss or damage.\n\nAttributes:\n    fnol_reference: FNOL reference number\n    date_of_loss: Date when loss occurred\n    time_of_loss: Time when loss occurred\n    location_of_loss: Location where loss occurred\n    cause_of_loss: Cause of loss (e.g., water damage, theft, collision)\n    nature_of_damage: Nature of damage or loss\n    extent_of_damage: Extent of damage (e.g., total loss, partial loss)\n    estimated_loss_amount: Estimated loss amount\n    estimated_loss_currency: Currency of estimated loss\n    salvage_value: Salvage value if applicable\n    salvage_value_currency: Currency of salvage value\n    survey_required: Whether survey is required\n    surveyor_name: Name of surveyor if appointed\n    police_report_filed: Whether police report was filed\n    police_report_number: Police report number if applicable",
      "properties": {
        "fnol_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "FNOL reference number",
          "title": "Fnol Reference"
        },
        "date_of_loss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date when loss occurred, e.g. 2023-01-01",
          "title": "Date Of Loss"
        },
        "time_of_loss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Time when loss occurred, e.g. 14:30",
          "title": "Time Of Loss"
        },
        "location_of_loss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Location where loss occurred",
          "title": "Location Of Loss"
        },
        "cause_of_loss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cause of loss (e.g., water damage, theft, collision, fire, storm)",
          "title": "Cause Of Loss"
        },
        "nature_of_damage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nature of damage or loss",
          "title": "Nature Of Damage"
        },
        "extent_of_damage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Extent of damage (e.g., total loss, partial loss, complete destruction)",
          "title": "Extent Of Damage"
        },
        "estimated_loss_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Estimated loss amount",
          "title": "Estimated Loss Amount"
        },
        "estimated_loss_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Currency of estimated loss, e.g. USD",
          "title": "Estimated Loss Currency"
        },
        "salvage_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Salvage value if applicable",
          "title": "Salvage Value"
        },
        "salvage_value_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Currency of salvage value, e.g. USD",
          "title": "Salvage Value Currency"
        },
        "survey_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether survey is required",
          "title": "Survey Required"
        },
        "surveyor_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Name of surveyor if appointed",
          "title": "Surveyor Name"
        },
        "police_report_filed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether police report was filed",
          "title": "Police Report Filed"
        },
        "police_report_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Police report number if applicable",
          "title": "Police Report Number"
        }
