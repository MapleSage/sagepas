apiVersion: v1
kind: ServiceAccount
metadata:
  name: sagepas-workload
  namespace: sagepas
  annotations:
    azure.workload.identity/client-id: "${WORKLOAD_IDENTITY_CLIENT_ID}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: sagepas-config
  namespace: sagepas
data:
  PORT: "3000"
  NODE_ENV: "production"
  STORAGE_ACCOUNT_NAME: "${STORAGE_ACCOUNT_NAME}"
  STORAGE_CONTAINER_NAME: "sagepas-documents"
  AZURE_ENTRA_TENANT_ID: "e9394f90-446d-41dd-8c8c-98ac08c5f090"
  AZURE_ENTRA_AUDIENCE: "api://d1ba82a8-a4e3-4f52-ab5f-2aa8ebee98e1"
  DEV_LOCAL_AUTH_ENABLED: "false"
  HUBSPOT_BRIDGE_URL: "https://51752298.hs-sites.com/hs/serverless/api/sagepas-sync"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sagepas-api
  namespace: sagepas
  labels: { app.kubernetes.io/name: sagepas-api, app.kubernetes.io/part-of: sagepas }
spec:
  replicas: 2
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
  selector:
    matchLabels: { app.kubernetes.io/name: sagepas-api }
  template:
    metadata:
      labels:
        app.kubernetes.io/name: sagepas-api
        app.kubernetes.io/part-of: sagepas
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: sagepas-workload
      securityContext:
        runAsNonRoot: true
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: api
          image: sageinsureacr6a05ef1f.azurecr.io/sagepas-api:${IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 3000 }]
          envFrom:
            - configMapRef: { name: sagepas-config }
            - secretRef: { name: sagepas-secrets }
          readinessProbe:
            httpGet: { path: /api/v1/health, port: http }
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          livenessProbe:
            httpGet: { path: /api/v1/health, port: http }
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests: { cpu: 250m, memory: 512Mi }
            limits: { cpu: "2", memory: 2Gi }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
      volumes:
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: sagepas-api
  namespace: sagepas
spec:
  selector: { app.kubernetes.io/name: sagepas-api }
  ports: [{ name: http, port: 3000, targetPort: http }]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: sagepas-api
  namespace: sagepas
spec:
  minAvailable: 1
  selector:
    matchLabels: { app.kubernetes.io/name: sagepas-api }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sagepas-web
  namespace: sagepas
  labels: { app.kubernetes.io/name: sagepas-web, app.kubernetes.io/part-of: sagepas }
spec:
  replicas: 2
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
  selector:
    matchLabels: { app.kubernetes.io/name: sagepas-web }
  template:
    metadata:
      labels: { app.kubernetes.io/name: sagepas-web, app.kubernetes.io/part-of: sagepas }
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: web
          image: sageinsureacr6a05ef1f.azurecr.io/sagepas-web:${IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 8080 }]
          readinessProbe:
            httpGet: { path: /healthz, port: http }
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /healthz, port: http }
            initialDelaySeconds: 10
            periodSeconds: 20
          resources:
            requests: { cpu: 50m, memory: 64Mi }
            limits: { cpu: 500m, memory: 256Mi }
          securityContext:
            runAsUser: 101
            runAsGroup: 101
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
          volumeMounts:
            - { name: nginx-cache, mountPath: /var/cache/nginx }
            - { name: nginx-run, mountPath: /var/run }
            - { name: nginx-tmp, mountPath: /tmp }
      volumes:
        - { name: nginx-cache, emptyDir: {} }
        - { name: nginx-run, emptyDir: {} }
        - { name: nginx-tmp, emptyDir: {} }
---
apiVersion: v1
kind: Service
metadata:
  name: sagepas-web
  namespace: sagepas
spec:
  selector: { app.kubernetes.io/name: sagepas-web }
  ports: [{ name: http, port: 80, targetPort: http }]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: sagepas-web
  namespace: sagepas
spec:
  minAvailable: 1
  selector:
    matchLabels: { app.kubernetes.io/name: sagepas-web }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: sagepas
  namespace: sagepas
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    nginx.ingress.kubernetes.io/proxy-body-size: "20m"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: nginx
  tls:
    - hosts: [pas.sagesure.io]
      secretName: sagepas-tls
  rules:
    - host: pas.sagesure.io
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: sagepas-web, port: { number: 80 } }
