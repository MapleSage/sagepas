# Microsoft Entra ID (Azure AD) — required. The app fails visibly at
# startup if any of these are missing; there is no hardcoded fallback
# client id and no "common"/organizations tenant fallback.

# App registration (client) id for this SPA in Entra ID.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Entra ID tenant id (GUID) — not "common", not "organizations".
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# API scope requested for the access token sent to the Rust API, e.g.
# api://<api-app-id>/access_as_user. Must match AZURE_ENTRA_AUDIENCE on
# the API (see api/.env.example).
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Must match a redirect URI registered on the SPA app registration.
VITE_REDIRECT_URI=http://localhost:5180/

# Optional: Entra External ID social identity providers. JSON array of
# { "label": string, "authority": string } — authorities are real Entra
# External ID user flow/policy URLs, not a client-side domain_hint trick.
# Leave unset to hide social sign-in buttons entirely.
# VITE_SOCIAL_AUTHORITIES=[{"label":"Google","authority":"https://<tenant>.ciamlogin.com/<tenant-id>/oauth2/v2.0/authorize?p=<policy>"}]
